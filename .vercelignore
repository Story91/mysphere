# Ignore deployment scripts.
# UWAGA: caly katalog scripts/ jest wykluczony z deploya, wiec NIE WOLNO tam
# trzymac niczego, co jest potrzebne przy buildzie na Vercelu.
app/basechat/Linea/scripts/
scripts/

# Ignore test files
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Ignore configuration files
hardhat.config.ts
hardhat.tsconfig.json

# Ignore documentation
docs/
*.md
# WYJATEK: strony /Docs importuja swoja tresc z markdownu W TRAKCIE BUILDA
# (app/Docs/*/page.tsx: `import content from '../_content/*.md'`, regula
# webpacka `.md` -> asset/source w next.config.js). Bez tego wyjatku `*.md`
# wycinal te pliki TYLKO na Vercelu, przez co CALY segment app/Docs znikal z
# builda - przechodzil bez ani jednej trasy /Docs, a produkcja dawala 404
# (lokalnie dzialalo, bo .vercelignore obowiazuje wylacznie na deployu).
# Negacja zostawia CALE app/Docs w deployu (tresc .md + diagramy mermaid).
!app/Docs/**

# Ignore contract artifacts
app/spheres/artifacts/
app/spheres/cache/
app/spheres/typechain-types/
artifacts/
cache/
typechain-types/

# Ignore development files
.env.local
.env.development

# Ignore git files
.git/
.gitignore

# Ignore camp contracts
camp-contract/

# Ignore specific scripts
scripts/deploy*.js
scripts/deploy*.ts
