# Ignore deployment scripts.
# `scripts/*` rather than `scripts/`, so the negation below can re-include a
# single file: gitignore syntax cannot re-include anything once its parent
# directory itself is excluded. package.json's `prebuild` runs
# copy-onchainkit-css.js, so that one file has to reach the build.
app/basechat/Linea/scripts/
scripts/*
!scripts/copy-onchainkit-css.js

# Ignore test files
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Ignore configuration files
hardhat.config.ts
hardhat.tsconfig.json

# Ignore documentation
docs/
*.md

# Ignore contract artifacts
app/spheres/artifacts/
app/spheres/cache/
app/spheres/typechain-types/
artifacts/
cache/
typechain-types/

# Ignore development files
.env.local
.env.development

# Ignore git files
.git/
.gitignore

# Ignore camp contracts
camp-contract/

# Ignore specific scripts
scripts/deploy*.js
scripts/deploy*.ts
