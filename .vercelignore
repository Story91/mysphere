# Ignore deployment scripts.
# UWAGA: caly katalog scripts/ jest wykluczony z deploya, wiec NIE WOLNO tam
# trzymac niczego, co jest potrzebne przy buildzie na Vercelu.
app/basechat/Linea/scripts/
scripts/

# Ignore test files
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Ignore configuration files
hardhat.config.ts
hardhat.tsconfig.json

# Ignore documentation
# OBIE reguly ZAKOTWICZONE do korzenia (wiodacy ukosnik). Bez kotwicy `docs/`
# lapal folder o TEJ nazwie na KAZDYM poziomie - a Vercel dopasowuje bez
# uwzgledniania wielkosci liter, wiec `docs/` usuwal CALE app/Docs (capital D)
# razem ze stronami .tsx. Efekt: build przechodzil, ale segment /Docs nie
# istnial -> 0 tras /Docs -> 404 na produkcji, choc lokalnie dzialalo.
# Analogicznie `*.md` bez ukosnika wycinal app/Docs/_content/*.md (import w
# buildzie). Zakotwiczone /docs/ i /*.md tykaja WYLACZNIE korzenia repo
# (folder docs/ oraz notatki STATUS.md, POSTY-*.md itd.). app/Docs zostaje.
/docs/
/*.md

# Ignore contract artifacts
app/spheres/artifacts/
app/spheres/cache/
app/spheres/typechain-types/
artifacts/
cache/
typechain-types/

# Ignore development files
.env.local
.env.development

# Ignore git files
.git/
.gitignore

# Ignore camp contracts
camp-contract/

# Ignore specific scripts
scripts/deploy*.js
scripts/deploy*.ts
