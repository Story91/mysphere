# Ignore deployment scripts.
# UWAGA: caly katalog scripts/ jest wykluczony z deploya, wiec NIE WOLNO tam
# trzymac niczego, co jest potrzebne przy buildzie na Vercelu.
app/basechat/Linea/scripts/
scripts/

# Ignore test files
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Ignore configuration files
hardhat.config.ts
hardhat.tsconfig.json

# Ignore documentation
docs/
# TYLKO markdown w KORZENIU repo (STATUS.md, POSTY-*.md, REDEFINICJA.md itd.).
# NIE `*.md` bez ukosnika: to lapalo TAKZE app/Docs/_content/*.md, ktore strony
# /Docs importuja W BUILDZIE (regula webpacka `.md` -> asset/source). Efekt:
# CALY segment app/Docs znikal z builda na Vercelu (0 tras /Docs, 404 na
# produkcji, choc lokalnie dzialalo - .vercelignore dziala tylko na deployu).
# Negacja `!app/Docs/**` NIE pomogla (parser .vercelignore ignoruje `!`), wiec
# zawezamy sam wzorzec do korzenia. Zagniezdzony markdown aplikacji zostaje.
/*.md

# Ignore contract artifacts
app/spheres/artifacts/
app/spheres/cache/
app/spheres/typechain-types/
artifacts/
cache/
typechain-types/

# Ignore development files
.env.local
.env.development

# Ignore git files
.git/
.gitignore

# Ignore camp contracts
camp-contract/

# Ignore specific scripts
scripts/deploy*.js
scripts/deploy*.ts
