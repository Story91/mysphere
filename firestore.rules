rules_version = '2';

// ============================================================================
// MySphere - reguly Firestore
//
// STAN ZASTANY (17 stycznia 2025 - 5 sierpnia 2026): cala baza byla otwarta
// regula `match /{document=**} { allow read, write: if true; }` z komentarzem
// "Tymczasowo". Przez 19 miesiecy kazdy, kto otworzyl konsole przegladarki,
// mogl skasowac wszystkie posty albo podmienic cudze dane - konfiguracja
// Firebase jest publiczna, bo trafia do bundle'a klienta.
//
// CZEGO TE REGULY NIE ROBIA I DLACZEGO:
// Aplikacja NIE loguje sie do Firebase Auth (getAuth jest zaimportowane, ale
// nie ma ani jednego signInWith*). Skutek: `request.auth` jest ZAWSZE null,
// wiec reguly nie moga sprawdzic, KTO pisze. Kazda regula w stylu "tylko
// wlasciciel moze edytowac" jest dzis niewykonalna - tozsamosc to tylko adres
// w polu dokumentu, a pole mozna wpisac dowolne.
//
// Prawdziwe domkniecie wymaga mintowania tokenu Firebase po weryfikacji SIWE
// (backend juz istnieje: /api/auth/verify), zeby request.auth.uid bylo adresem
// portfela. Dopiero wtedy da sie egzekwowac wlasnosc.
//
// DLATEGO ISTNIEJACE KOLEKCJE ZOSTAJA NA RAZIE OTWARTE - zamkniecie ich bez
// warstwy tozsamosci albo nic nie da, albo zablokuje dzialajace funkcje.
// ZYSK JEST W SEKCJI NOWYCH KOLEKCJI: sa od poczatku scisle walidowane.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // NOWE KOLEKCJE ponizej musza stac PRZED regula ogolna na koncu pliku.
    // Firestore przyznaje dostep, gdy JAKAKOLWIEK pasujaca regula na to
    // pozwala, a sciezki sa rozlaczne, wiec obie sekcje wspolistnieja.

    // ========================================================================
    // PROFILE TOKENOW LAUNCHPADA
    // ========================================================================
    // docId = adres tokena, lowercase. Trzyma WYLACZNIE warstwe edytowalna:
    // logo, opis i linki. Cena, rezerwa, stan krzywej i oplaty pochodza z
    // lancucha i nigdy stad nie sa czytane.
    //
    // ZAPIS JEST ZAMKNIETY DLA PRZEGLADARKI I TO JEST CELOWE. Prawo do tokena
    // ma tylko jego tworca, a sprawdzic to da sie wylacznie odczytem
    // `launchOf(token).creator` z lancucha - regula Firestore tego nie potrafi.
    // Zapisuje wiec serwer, przez firebase-admin (admin SDK omija te reguly),
    // po sprawdzeniu sesji SIWE ORAZ tworcy z lancucha:
    // app/api/launchpad/token/route.ts.
    //
    // UWAGA, KTORA KOSZTOWALA JUZ JEDEN BLAD W TYM PLIKU: samo napisanie
    // `allow write: if false` NIE zamyka zapisu. Na koncu pliku stoi regula
    // ogolna `allow read, write: if !hasOwnRules(collection)`, a Firestore
    // wpuszcza, gdy pozwala JAKAKOLWIEK pasujaca regula. Dopoki nazwa kolekcji
    // nie znajdzie sie na liscie w `hasOwnRules`, ponizsze `if false` jest
    // martwe i kazdy anonimowy klient pisze tu bezposrednio, omijajac bramke
    // z sesja SIWE i sprawdzeniem tworcy z lancucha.
    // `launchpadTokens` JEST na tej liscie - patrz `hasOwnRules` nizej.
    match /launchpadTokens/{tokenAddress} {
      allow read: if true;
      allow write: if false;
    }

    // ========================================================================
    // CACHE HISTORII TOKENA LAUNCHPADA
    // ========================================================================
    // Odtworzona z logow historia jednego tokena: transakcje krzywej i salda
    // holderow. Zrodlem prawdy jest lancuch, ta kolekcja jest wylacznie
    // przyspieszeniem - patrz app/api/launchpad/historyStore.ts.
    //
    // ODCZYT jest jawny, bo to publiczne logi. ZAPIS nalezy wylacznie do
    // serwera (/api/launchpad/history), ktory sam je skanuje. Gdyby pisala tu
    // przegladarka, dalo by sie narysowac dowolny wykres i dowolna liste
    // transakcji dowolnego tokena - a to jest pierwsza rzecz, ktora widzi
    // ktos decydujacy o zakupie.
    //
    // Wiersze leza w podkolekcji `parts`, stad druga regula. Nazwa kolekcji
    // JEST na liscie w `hasOwnRules` - bez tego obie te reguly byly by martwa
    // dekoracja, dokladnie jak opisuje akapit wyzej.
    match /launchpadHistory/{tokenKey} {
      allow read: if true;
      allow write: if false;
    }

    match /launchpadHistory/{tokenKey}/{rest=**} {
      allow read: if true;
      allow write: if false;
    }

    // ========================================================================
    // INDEKS TOKENOW LAUNCHPADA
    // ========================================================================
    // Lista startow na siec: adres, nazwa, symbol, tworca, blok startu. Dane
    // niezmienne, odtworzone ze zdarzen `Launched` przez /api/launchpad/board.
    //
    // ZAPIS TYLKO Z SERWERA i to nie jest formalnosc: z tej listy powstaje
    // TABLICA. Kto moglby do niej pisac, dopisalby token, ktorego nikt nie
    // wystartowal, albo podmienil nazwe i symbol istniejacego - czyli
    // podszylby sie pod cudzy launch w miejscu, w ktorym ludzie wybieraja, co
    // kupic. Odczyt jawny, bo te dane i tak sa na lancuchu.
    //
    // `launchpadTokenIndex` JEST na liscie w `hasOwnRules` - bez tego ta
    // regula bylaby martwa dekoracja.
    match /launchpadTokenIndex/{chainKey} {
      allow read: if true;
      allow write: if false;
    }

    // ========================================================================
    // AGREGAT TABLICY LAUNCHPADA
    // ========================================================================
    // Liczby tablicy jednej sieci, odtworzone z logow: wolumen, liczba
    // transakcji, handlujacy, ceny do sparkline'a, naliczenia oplat i tasma
    // zdarzen - razem z blokiem, do ktorego sa policzone. Zapis robi wylacznie
    // /api/launchpad/board/stats, po skanie lancucha.
    //
    // ODCZYT jest jawny, bo to publiczne logi. ZAPIS nalezy wylacznie do
    // serwera i to nie jest formalnosc: po TYCH liczbach sortuje sie Trending i
    // Top volume, czyli miejsce, w ktorym ludzie wybieraja, co kupic. Kto
    // moglby tu pisac, wystawilby dowolnemu tokenowi dowolny wolumen.
    //
    // Kawalki lezą w podkolekcji `parts`, stad druga regula. Nazwa kolekcji
    // JEST na liscie w `hasOwnRules` - bez tego obie te reguly bylyby martwa
    // dekoracja.
    match /launchpadBoardStats/{boardKey} {
      allow read: if true;
      allow write: if false;
    }

    match /launchpadBoardStats/{boardKey}/{rest=**} {
      allow read: if true;
      allow write: if false;
    }

    // ========================================================================
    // REJESTR AGENTOW
    // ========================================================================
    // docId = adres wlasciciela, lowercase. Dzieki temu dopasowanie autora
    // z feedu to odczyt po kluczu, a nie skanowanie kolekcji.
    match /agents/{agentId} {
      function isAgentAddr(v) {
        return v is string && v.matches('^0x[0-9a-f]{40}$');
      }
      // Aktualizacja metadanych NIE moze ruszyc licznikow reputacji.
      function isMetadataUpdate() {
        return request.resource.data.address == resource.data.address
            && request.resource.data.feedbackCount == resource.data.feedbackCount
            && request.resource.data.scoreSum == resource.data.scoreSum;
      }
      // Jedna opinia = licznik +1, a suma ocen zmienia sie najwyzej o 100.
      function isFeedbackCounterUpdate() {
        return request.resource.data.address == resource.data.address
            && request.resource.data.feedbackCount == resource.data.feedbackCount + 1
            && request.resource.data.scoreSum >= resource.data.scoreSum - 100
            && request.resource.data.scoreSum <= resource.data.scoreSum + 100;
      }

      // Odznaki w feedzie czyta kazdy, tak jak same posty.
      allow read: if true;

      allow create: if isAgentAddr(agentId)
                    && request.resource.data.address == agentId
                    && isAgentAddr(request.resource.data.ownerAddress)
                    && request.resource.data.masterAgentId == agentId
                    && request.resource.data.feedbackCount == 0
                    && request.resource.data.scoreSum == 0
                    && request.resource.data.registeredAtMs is number;

      allow update: if isMetadataUpdate() || isFeedbackCounterUpdate();
      allow delete: if false;
    }

    // ========================================================================
    // OPINIE O AGENTACH
    // ========================================================================
    match /agentFeedback/{feedbackId} {
      allow read: if true;

      allow create: if request.resource.data.agentAddress is string
                    && request.resource.data.agentAddress.matches('^0x[0-9a-f]{40}$')
                    && exists(/databases/$(database)/documents/agents/$(request.resource.data.agentAddress))
                    && request.resource.data.commenterAddress is string
                    && request.resource.data.commenterAddress.matches('^0x[0-9a-f]{40}$')
                    && request.resource.data.score is int
                    && request.resource.data.score >= -100
                    && request.resource.data.score <= 100
                    && request.resource.data.createdAtMs is number
                    && (!('comment' in request.resource.data)
                        || request.resource.data.comment.size() <= 280);

      // Opinia jest niezmienna - reputacja liczy sie z tego, co juz zapisane.
      allow update, delete: if false;
    }

    // ========================================================================
    // TIP-TO-UNLOCK
    // ========================================================================
    // docId = "{postId}__{wallet_lowercase}" - zapis jest idempotentny,
    // a odczyt zbiorczy idzie po documentId(), wiec nie trzeba indeksow.
    match /unlocks/{unlockId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll([
                         'postId','walletAddress','creatorAddress','amount','token',
                         'network','chainId','txHash','unlockedAt','verified'])
                    && unlockId == request.resource.data.postId + '__' + request.resource.data.walletAddress
                    && request.resource.data.walletAddress is string
                    && request.resource.data.walletAddress == request.resource.data.walletAddress.lower()
                    && request.resource.data.creatorAddress is string
                    && request.resource.data.creatorAddress == request.resource.data.creatorAddress.lower()
                    && request.resource.data.walletAddress != request.resource.data.creatorAddress
                    && request.resource.data.txHash is string
                    && request.resource.data.txHash.size() == 66
                    && request.resource.data.network == 'base'
                    && request.resource.data.chainId == 8453
                    && request.resource.data.token in ['ETH','USDC']
                    && request.resource.data.verified in ['strict','receipt-only']
                    && request.resource.data.unlockedAt is int;

      // Nadpisanie dozwolone tylko dla tej samej pary (post, portfel).
      allow update: if request.resource.data.postId == resource.data.postId
                    && request.resource.data.walletAddress == resource.data.walletAddress;

      allow delete: if false;
    }

    // ========================================================================
    // WSPARCIE TWORCOW
    // ========================================================================
    // To NIE jest subskrypcja odnawialna: platnosc z gory za okres, wygasa
    // po expiresAt i nikt nie moze obciazyc portfela ponownie.
    match /creatorSubscriptions/{subscriptionId} {
      allow read: if true;

      allow create, update: if request.resource.data.keys().hasAll([
                                 'subscriberAddress','creatorAddress','tier','periodDays',
                                 'startedAt','expiresAt','lastPaymentTx','amount','token',
                                 'network','chainId','updatedAt','verified'])
                            && subscriptionId == request.resource.data.subscriberAddress + '__' + request.resource.data.creatorAddress
                            && request.resource.data.subscriberAddress is string
                            && request.resource.data.subscriberAddress == request.resource.data.subscriberAddress.lower()
                            && request.resource.data.creatorAddress is string
                            && request.resource.data.creatorAddress == request.resource.data.creatorAddress.lower()
                            && request.resource.data.subscriberAddress != request.resource.data.creatorAddress
                            && request.resource.data.tier in ['supporter','insider','patron']
                            && request.resource.data.periodDays is int
                            && request.resource.data.periodDays > 0
                            && request.resource.data.expiresAt is int
                            && request.resource.data.expiresAt > request.time.toMillis()
                            && request.resource.data.lastPaymentTx is string
                            && request.resource.data.lastPaymentTx.size() == 66
                            && request.resource.data.network == 'base'
                            && request.resource.data.chainId == 8453
                            && request.resource.data.token == 'USDC'
                            // Adresy w rekordzie sa niezmienne przy przedluzeniu.
                            && (!('subscriberAddress' in resource.data)
                                || request.resource.data.subscriberAddress == resource.data.subscriberAddress)
                            && (!('creatorAddress' in resource.data)
                                || request.resource.data.creatorAddress == resource.data.creatorAddress);

      allow delete: if false;
    }

    // ========================================================================
    // POSTEPY AGENTOW W MYCLAW ACADEMY
    // ========================================================================
    // docId = "{agentAddress_lowercase}__{discipline}" - zapis idempotentny,
    // odczyt po kluczu, bez indeksow zlozonych (ten sam wzorzec co `unlocks`).
    //
    // NAJWAZNIEJSZA REGULA TEJ SEKCJI: `examAttempts` (log podejsc do egzaminu)
    // jest TYLKO DOPISYWALNY. Gdyby dalo sie go skrocic albo nadpisac, agent
    // kasowalby historie i obchodzil cooldown oraz limit dzienny - czyli
    // wracalibysmy do brute-force'owania egzaminu za $0.01 od proby. To samo
    // dotyczy `challengeLog`, `completedLessons` i `passedChallenges`.
    //
    // `certified` jest jednokierunkowe (false -> true): po zdaniu dyscyplina
    // jest zamknieta i nikt nie moze jej "odzdac", zeby dostac nowe podejscia.
    match /agentProgress/{progressId} {
      function isAgentAddr(v) {
        return v is string && v.matches('^0x[0-9a-f]{40}$');
      }

      function validIdentity() {
        return isAgentAddr(request.resource.data.agentAddress)
            && request.resource.data.agentAddress == request.resource.data.agentAddress.lower()
            && request.resource.data.discipline in ['trading','defi','security','social','creative']
            && progressId == request.resource.data.agentAddress + '__' + request.resource.data.discipline
            && request.resource.data.updatedAt is number;
      }

      // Pole listowe jest opcjonalne (dokument powstaje przy pierwszym zapisie
      // i moze zawierac tylko czesc pol), ale jesli jest - musi byc lista.
      function listOk(field) {
        return !(field in request.resource.data) || request.resource.data[field] is list;
      }

      // TYLKO DOPISYWANIE: nowa lista musi zawierac wszystkie dotychczasowe
      // elementy i nie moze byc krotsza. To odrzuca skrocenie tablicy, podmiane
      // wpisow, arrayRemove oraz usuniecie calego pola (deleteField) - czyli
      // kazdy sposob skasowania historii podejsc.
      //
      // Swiadomie NIE wymuszamy zachowania KOLEJNOSCI (dalby to warunek na
      // prefiksie listy): przestawienie wpisow niczego nie obchodzi, bo limity
      // licza sie z timestampow, a nie z pozycji w tablicy.
      function appendOnly(field) {
        return !(field in resource.data)
            || ( field in request.resource.data
                 && request.resource.data[field] is list
                 && request.resource.data[field].size() >= resource.data[field].size()
                 && request.resource.data[field].hasAll(resource.data[field]) );
      }

      // Odznaki i historia sa publiczne - tak jak reputacja agentow wyzej.
      allow read: if true;

      allow create: if validIdentity()
                    && listOk('completedLessons')
                    && listOk('passedChallenges')
                    && listOk('challengeLog')
                    && listOk('examAttempts')
                    && (!('certified' in request.resource.data)
                        || request.resource.data.certified is bool)
                    // Certyfikat nie moze powstac bez ani jednego podejscia.
                    && (!('certified' in request.resource.data)
                        || request.resource.data.certified == false
                        || ('examAttempts' in request.resource.data
                            && request.resource.data.examAttempts.size() > 0));

      allow update: if validIdentity()
                    // Tozsamosc dokumentu jest niezmienna.
                    && request.resource.data.agentAddress == resource.data.agentAddress
                    && request.resource.data.discipline == resource.data.discipline
                    && listOk('completedLessons')
                    && listOk('passedChallenges')
                    && listOk('challengeLog')
                    && listOk('examAttempts')
                    && appendOnly('completedLessons')
                    && appendOnly('passedChallenges')
                    && appendOnly('challengeLog')
                    && appendOnly('examAttempts')
                    // certified: tylko false -> true, nigdy z powrotem.
                    && (!('certified' in resource.data)
                        || resource.data.certified != true
                        || request.resource.data.certified == true)
                    // Znacznik ostatniej proby nie moze sie cofnac.
                    && (!('lastAttemptAt' in resource.data)
                        || (request.resource.data.lastAttemptAt is number
                            && request.resource.data.lastAttemptAt >= resource.data.lastAttemptAt));

      // Kasowanie postepu = kasowanie limitu prob. Nigdy.
      allow delete: if false;
    }

    // ========================================================================
    // ASKI - pytanie z budzetem, liczba miejsc i terminem
    // ========================================================================
    // Samo pytanie jest JAWNE od poczatku. Zapieczetowane sa ODPOWIEDZI, i to
    // one maja tu trzy osobne reguly (patrz dwie sekcje nizej).
    //
    // Najwazniejsze, czego te reguly pilnuja: `budget`, `seats` i `deadline` sa
    // NIEZMIENNE po utworzeniu. Ask, ktoremu mozna obnizyc budzet albo cofnac
    // termin po tym, jak ktos juz napisal odpowiedz, zamienia caly mechanizm w
    // darmowa prace - a to jest dokladnie ryzyko, ktore Ask przenosi na
    // piszacego (app/utils/asks/types.ts).
    match /asks/{askId} {
      function isAddr(v) {
        return v is string && v.matches('^0x[0-9a-fA-F]{40}$');
      }

      // Feed czyta Aski tak samo jak posty.
      allow read: if true;

      allow create: if isAddr(request.resource.data.author)
                    && request.resource.data.question is string
                    && request.resource.data.question.size() > 0
                    && request.resource.data.question.size() <= 500
                    && request.resource.data.budget is number
                    && request.resource.data.budget > 0
                    && request.resource.data.seats is int
                    && request.resource.data.seats >= 1
                    && request.resource.data.seats <= 20
                    && request.resource.data.perAnswer is number
                    && request.resource.data.token is string
                    && request.resource.data.network is string
                    // Termin w przeszlosci daje Aska martwego w chwili narodzin.
                    && request.resource.data.deadline is number
                    && request.resource.data.deadline > request.time.toMillis()
                    && request.resource.data.status == 'open'
                    // DWA WARIANTY FINANSOWANIA I ANI JEDNEGO WIECEJ.
                    //
                    // 'on-resolve' - autor placi z wlasnego portfela przy
                    //    przyjmowaniu; nic nie jest zablokowane i karta ma to
                    //    mowic wprost.
                    // 'escrowed'   - budzet lezy na kontrakcie AskEscrow.
                    //    WYMAGAMY hasha transakcji `fund`. Bez niego slowo
                    //    "escrowed" w dokumencie jest obietnica bez pokrycia
                    //    wpisana wprost do bazy - a regula jest ostatnim
                    //    miejscem, ktorego nie da sie ominac inna sciezka zapisu.
                    //
                    // CZEGO TA REGULA NIE SPRAWDZA: czy pod tym hashem naprawde
                    // lezy transakcja `fund` na wlasciwa kwote. Firestore nie
                    // czyta lancucha. Sprawdza to klient przed zapisem
                    // (app/utils/asks/escrow.ts) i moze sprawdzic kazdy przez
                    // publiczny odczyt escrowFor(author, askId).
                    && ((request.resource.data.funding == 'on-resolve')
                        || (request.resource.data.funding == 'escrowed'
                            && request.resource.data.escrowTxHash is string
                            && request.resource.data.escrowTxHash.size() == 66))
                    && request.resource.data.answerCount == 0
                    && request.resource.data.acceptedCount == 0;

      allow update: if request.resource.data.author == resource.data.author
                    && request.resource.data.question == resource.data.question
                    && request.resource.data.budget == resource.data.budget
                    && request.resource.data.seats == resource.data.seats
                    && request.resource.data.deadline == resource.data.deadline
                    && request.resource.data.funding == resource.data.funding
                    // Liczniki tylko w gore i nigdy ponad liczbe miejsc.
                    && request.resource.data.answerCount is number
                    && request.resource.data.answerCount >= resource.data.answerCount
                    && request.resource.data.acceptedCount is number
                    && request.resource.data.acceptedCount >= resource.data.acceptedCount
                    && request.resource.data.acceptedCount <= resource.data.seats
                    // Rozstrzygniecie jest jednokierunkowe: Ask raz zamkniety
                    // nie moze wrocic do `open`, bo `resolve rate` autora
                    // przestalby cokolwiek znaczyc.
                    && (resource.data.status != 'resolved'
                        || request.resource.data.status == 'resolved')
                    // WYGASNIECIE TAK SAMO JEDNOKIERUNKOWE.
                    // Bez tego Ask oznaczony jako porzucony dalo sie cofnac do
                    // 'open' i wyczyscic sobie wskaznik rozstrzygalnosci -
                    // czyli dokladnie ta liczbe, ktora ma pokazywac, ze ktos
                    // zebral cudza prace i nie zaplacil.
                    && (resource.data.status != 'expired'
                        || request.resource.data.status == 'expired')
                    // "WYGASL" TO ZDANIE O PIENIADZACH I WYMAGA DOWODU.
                    //
                    // Znaczy: budzet wrocil z kontraktu do autora, pomniejszony
                    // o oplate. Bez hasha byloby to nasze slowo o cudzych
                    // srodkach - ten sam problem, ktory przy zakladaniu Aska
                    // rozwiazuje `escrowTxHash`, i to samo lekarstwo.
                    //
                    // Wymagane WYLACZNIE przy `funding == 'escrowed'`: przy
                    // 'on-resolve' nic nie bylo zablokowane, wiec nie ma
                    // transakcji zwrotu, ktora mogla by byc dowodem, i zadanie
                    // hasha uniemozliwiloby oznaczenie takiego Aska w ogole.
                    && (request.resource.data.status != 'expired'
                        || resource.data.funding != 'escrowed'
                        || (request.resource.data.expiredTxHash is string
                            && request.resource.data.expiredTxHash.size() == 66));

      // Skasowany Ask to skasowana historia rozstrzygalnosci.
      allow delete: if false;
    }

    // ========================================================================
    // METADANE ODPOWIEDZI - jawne jest TO, ZE ktos odpowiedzial
    // ========================================================================
    // Karta ma pokazywac "7 answers sealed until resolve", wiec liczba i autorzy
    // sa publiczni. Sama tresc mieszka gdzie indziej (sekcja nizej).
    //
    // TWORZY JE WYLACZNIE SERWER (POST /api/asks/answers). Klient nie ma jak
    // zapisac odpowiedzi poprawnie, bo tresc musi w tym samym kroku trafic do
    // `askAnswerContent`, gdzie przegladarka nie siega. Dopuszczenie zapisu
    // z klienta dawaloby metadane bez tresci - odpowiedz widoczna w liczniku
    // i pusta przy rozstrzygnieciu.
    match /askAnswers/{answerId} {
      allow read: if true;

      allow create, delete: if false;

      // Jedyna zmiana dopuszczalna z przegladarki: przyjecie odpowiedzi wraz
      // z DOWODEM wyplaty. Bez hasha "przyjeta" jest samym slowem, a caly
      // produkt stoi na tym, ze kwoty da sie sprawdzic (patrz acceptAnswer).
      allow update: if request.resource.data.askId == resource.data.askId
                    && request.resource.data.author == resource.data.author
                    && request.resource.data.createdAt == resource.data.createdAt
                    && resource.data.accepted == false
                    && request.resource.data.accepted == true
                    && request.resource.data.payoutTxHash is string
                    && request.resource.data.payoutTxHash.size() == 66;
    }

    // ========================================================================
    // TRESC ODPOWIEDZI - przegladarka nie ma tu wstepu WCALE
    // ========================================================================
    // Druga kolekcja w tym pliku zamknieta calkowicie, z tego samego powodu co
    // `premiumContent`: feed czyta Firestore klienckim SDK, wiec dopoki tresc
    // siedzi w dokumencie odpowiedzi, kazdy widzi ja w ruchu sieciowym. Zaslona
    // w UI to nie zapieczetowanie. Manifest obiecuje, ze odpowiedzi sa "sealed
    // until you resolve: nobody can read what anyone else wrote, so nobody can
    // rewrite it slightly and take a seat with it" - a tego nie da sie dotrzymac
    // po stronie klienta.
    //
    // Czyta i pisze wylacznie serwer klientem administracyjnym (firebase-admin),
    // ktory reguly omija z definicji. Wydaje ja GET /api/asks/{id}/answers po
    // sprawdzeniu jednego z trzech warunkow: Ask jest `resolved`, pytajacy jest
    // autorem Aska, albo pyta o wlasna odpowiedz.
    //
    // ---------------------------------------------------------------------
    // UWAGA, KTORA MUSI TU STAC: `if false` DZIS NIE WYSTARCZA
    // ---------------------------------------------------------------------
    // Na koncu tego pliku stoi `match /{document=**} { allow read, write: if
    // true; }`. Firestore przyznaje dostep, gdy pozwala JAKAKOLWIEK pasujaca
    // regula, a rekursywny wildcard pasuje do KAZDEGO dokumentu w bazie -
    // takze do `askAnswerContent` i do `premiumContent`. Naglowek tego pliku
    // mowi, ze "sciezki sa rozlaczne"; z regula `{document=**}` rozlaczne nie
    // sa. Dopoki tam stoi, obie te kolekcje sa czytelne dla przegladarki mimo
    // `if false`.
    //
    // Zamkniecie wymaga zawezenia tamtej reguly do wyliczonej listy istniejacych
    // kolekcji (posts, users, comments, likes, tips, ...), czyli zmiany, ktora
    // dotyka calej dzialajacej aplikacji i nie miesci sie w tej zmianie. Do tego
    // czasu jedyna realna bramka na tresci odpowiedzi jest trasa serwerowa.
    match /askAnswerContent/{answerId} {
      allow read, write: if false;
    }

    // ========================================================================
    // ISTNIEJACE KOLEKCJE - NADAL OTWARTE
    // ========================================================================
    // premiumContent - TRESC PLATNA. Przegladarka nie ma tu wstepu WCALE.
    // ========================================================================
    //
    // To jest jedyna kolekcja w tym pliku zamknieta calkowicie, i to jest
    // caly sens jej istnienia. Wczesniej tresc premium siedziala w dokumencie
    // posta; feed czyta posty klienckim SDK, wiec kazdy widzial platny tekst w
    // odpowiedzi sieciowej bez placenia. Paywall byl zaslona w UI.
    //
    // Teraz czyta i pisze wylacznie serwer, klientem administracyjnym
    // (firebase-admin), ktory reguly omija z definicji. `if false` dotyczy
    // przegladarki - i ma dotyczyc.
    //
    // Wydaje ja GET /api/premium po sprawdzeniu DWOCH rzeczy: podpisanej sesji
    // SIWE (kim jestes) oraz rekordu w `unlocks` albo autorstwa posta (czy masz
    // prawo). Zapisuje POST /api/premium, wylacznie autorowi posta.
    match /premiumContent/{postId} {
      allow read, write: if false;
    }

    // ========================================================================
    // posts, users, comments, likes, tips, friendships, friendRequests, groups,
    // paidPins, payments, referrals, referralStats, referralRewards, usernames,
    // userRatings, baseNameFeed, mySphereUserSocials, authorizedQuotes
    // + subkolekcje users/{id}/{followers,following,friends,notifications,settings}
    //
    // Nie zamykamy ich teraz - patrz naglowek pliku. Bez Firebase Auth reguly
    // nie wiedza, kto pisze, wiec zamkniecie na slepo albo nic nie zmieni, albo
    // zablokuje dzialajace funkcje (aplikacja zapisuje i kasuje w kilkunastu
    // miejscach).
    //
    // KOLEJNY KROK: po weryfikacji SIWE mintowac token Firebase z uid = adres
    // portfela, zalogowac klienta przez signInWithCustomToken i DOPIERO WTEDY
    // zamienic ta regule na wymagajaca request.auth.uid == wlasciciel dokumentu.
    //
    // ========================================================================
    // TA REGULA UNIEWAZNIALA WSZYSTKO POWYZEJ. NAPRAWIONE.
    // ========================================================================
    // Bylo tu `match /{document=**} { allow read, write: if true; }`.
    // Rekursywny wildcard pasuje do KAZDEGO dokumentu w bazie, a Firestore
    // przyznaje dostep, gdy pozwala JAKAKOLWIEK pasujaca regula. Skutek: kazde
    // `allow ... : if false` i kazda walidacja z gornej czesci pliku byly
    // OZDOBA. Konkretnie i sprawdzalnie:
    //
    //   - `askAnswerContent` (tresci odpowiedzi) mialo `if false`, a bylo
    //     czytelne dla kazdej przegladarki. Opis strony /asks obiecuje
    //     "Answers stay sealed - nobody can read what anyone else wrote before
    //     the author opens them". Ta obietnica byla NIEPRAWDZIWA.
    //   - `premiumContent` - to samo. Platna tresc do wziecia za darmo
    //     bezposrednio z bazy, z pominieciem /api/premium.
    //   - `askAnswers.update` wymagalo hasha wyplaty; bez niego dalo sie
    //     oznaczyc dowolna odpowiedz jako przyjeta.
    //   - `asks.create` wymagalo escrowTxHash przy funding == 'escrowed';
    //     dalo sie wiec wpisac "escrowed" bez zablokowania ani centa.
    //
    // Naglowek tego pliku twierdzil, ze "sciezki sa rozlaczne". Z regula
    // `{document=**}` rozlaczne nie sa - i to jedno zdanie kosztowalo cztery
    // powyzsze dziury.
    //
    // ROZWIAZANIE: regula ogolna przestaje byc rekursywna i omija kolekcje,
    // ktore maja wlasne reguly. Kolekcje ZASTANE zostaja dokladnie tak otwarte
    // jak byly - nie ma tu zadnego zaciskania istniejacych funkcji, wiec ta
    // zmiana nie moze niczego zepsuc w dzialajacej aplikacji. Zmienia sie
    // wylacznie to, ze reguly nowych kolekcji zaczynaja obowiazywac.
    //
    // DWIE REGULY, NIE JEDNA: pierwsza obsluguje dokumenty w kolekcji
    // (`/posts/{id}`), druga wszystko pod nimi (`/users/{id}/followers/{id}`).
    // Rekursywny wildcard robil oba naraz - rozbicie go jest cena za to, ze
    // da sie wskazac pierwszy segment sciezki.
    //
    // DOPISUJAC NOWA KOLEKCJE Z WLASNYMI REGULAMI, DOPISZ JA TEZ TUTAJ.
    // Inaczej jej reguly beda dekoracja, dokladnie jak przed ta poprawka.
    function hasOwnRules(name) {
      return name in [
        'agents',
        'agentFeedback',
        'agentProgress',
        'asks',
        'askAnswers',
        'askAnswerContent',
        'unlocks',
        'creatorSubscriptions',
        'premiumContent',
        'tips',
        'curatorWatch',
        'curatorChanges',
        'launchpadTokens',
        'launchpadHistory',
        'launchpadTokenIndex',
        'launchpadBoardStats'
      ];
    }

    // ========================================================================
    // NAPIWKI - KOLEKCJA, NA KTOREJ STOI CALA TEZA PRODUKTU
    // ========================================================================
    // `tips` wpadalo dotad pod regule ogolna, czyli `allow read, write: if true`.
    // Odczyt jest w porzadku i ma taki zostac - te dane sa jawne z zalozenia
    // i cale /leaderboard je pokazuje.
    //
    // ZAPIS BYL KATASTROFA I NIKT TEGO NIE ZAUWAZYL. Kazdy, kto otworzyl
    // konsole przegladarki, mogl:
    //   - PRZEPISAC dowolny z 189 istniejacych napiwkow (inna kwota, inny
    //     odbiorca, inny hash),
    //   - SKASOWAC cala kolekcje,
    //   - dopisac dowolna liczbe zmyslonych platnosci.
    //
    // Produkt, ktorego jedno zdanie brzmi "reputacje bije sie wylacznie
    // rozliczonymi platnosciami", trzymal te platnosci w kolekcji zapisywalnej
    // przez kazdego. Hash w POJEDYNCZYM wierszu jest sprawdzalny na lancuchu -
    // ale ZBIOR jako calosc mogl zatruc ktokolwiek, a to wlasnie zbior
    // pokazuje ranking i wskazniki.
    //
    // === DLACZEGO NIE ZAMYKAM ZAPISU CALKIEM ===
    // saveTip() w app/utils/firebase.ts wola addDoc Z PRZEGLADARKI. Zamkniecie
    // create zepsuloby napiwki natychmiast. Docelowo zapis powinien isc przez
    // trase serwerowa weryfikujaca transakcje na lancuchu - `verifyBasePayment`
    // juz istnieje i robi dokladnie to dla Askow. To osobna zmiana.
    //
    // === CZEGO NIE WYMAGAM I DLACZEGO ===
    // NIE wymagam `txHash`. Z 189 napiwkow tylko 18 ma hash - reszta pochodzi
    // ze sciezek, ktore go nie zapisuja. Wymuszenie go tutaj zablokowaloby
    // wysylanie napiwkow wiekszosci ludzi, czyli naprawa zepsulaby dzialajaca
    // funkcje. To ma byc pierwszy stopien, nie ostatni.
    //
    // Zostaje wiec: walidacja ksztaltu przy tworzeniu ORAZ - najwazniejsze -
    // zakaz zmiany i kasowania. Historia platnosci staje sie dopisywalna,
    // ale NIEODWRACALNA, a to jest cecha, ktora ta kolekcja musiala miec
    // od pierwszego dnia.
    match /tips/{tipId} {
      allow read: if true;

      allow create: if request.resource.data.senderAddress is string
                    && request.resource.data.senderAddress.matches('^0x[0-9a-fA-F]{40}$')
                    && request.resource.data.recipientAddress is string
                    && request.resource.data.recipientAddress.matches('^0x[0-9a-fA-F]{40}$')
                    && request.resource.data.senderAddress != request.resource.data.recipientAddress
                    && request.resource.data.timestamp is number;

      // Paragon, ktory da sie poprawic, nie jest paragonem.
      allow update, delete: if false;
    }

    // ========================================================================
    // ZAPIS DZIALAN KURATORA - CZYTA KAZDY, PISZE WYLACZNIE SERWER
    // ========================================================================
    // `curatorWatch` trzyma JEDEN dokument z ostatnia migawka parametrow
    // notowanych skarbcow Morpho na Base. `curatorChanges` trzyma po jednym
    // dokumencie na wykryta roznice: prowizja z 5% na 15%, zmiana kuratora,
    // wejscie albo zejscie z listy notowanych.
    //
    // ODCZYT JAWNY, bo to jest cala idea tego rejestru: zapis, ktorego nie da
    // sie przeczytac bez logowania, nie jest publicznym zapisem.
    //
    // ZAPIS ZAMKNIETY NA GLUCHO i to nie jest ostroznosc na wyrost. Wpis brzmi
    // "ten kurator podniosl tego dnia prowizje" - czyli jest twierdzeniem
    // o konkretnej, nazwanej z imienia firmie. Kolekcja zapisywalna z konsoli
    // przegladarki zamienia taki rejestr w narzedzie do obgadywania cudzej
    // reputacji, i to podpisane naszym interfejsem. Ta sama pomylka kosztowala
    // juz kolekcje `tips` (patrz wyzej): kazdy mogl przepisac cudzy napiwek.
    //
    // `if false` NIE blokuje naszego zapisu: trasa /api/curator-watch pisze
    // kluczem administracyjnym (app/utils/auth/firebaseAdmin.ts), a admin SDK
    // omija reguly z definicji. Przegladarka nie ma tu zadnej drogi zapisu
    // i miec nie powinna.
    match /curatorWatch/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /curatorChanges/{changeId} {
      allow read: if true;
      allow write: if false;
    }

    match /{collection}/{docId} {
      allow read, write: if !hasOwnRules(collection);
    }

    match /{collection}/{docId}/{rest=**} {
      allow read, write: if !hasOwnRules(collection);
    }
  }
}
