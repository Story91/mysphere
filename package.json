{
  "name": "basebook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/copy-onchainkit-css.js",
    "dev": "next dev -H 0.0.0.0",
    "build": "next build --no-lint",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "contracts:compile": "hardhat compile",
    "contracts:deploy": "cross-env TS_NODE_PROJECT=./hardhat.tsconfig.json hardhat run app/basemorning/scripts/deploy.ts",
    "contracts:deploy:base": "cross-env TS_NODE_PROJECT=./hardhat.tsconfig.json hardhat run app/basemorning/scripts/deploy.ts --network base",
    "contracts:deploy:goerli": "cross-env TS_NODE_PROJECT=./hardhat.tsconfig.json hardhat run app/basemorning/scripts/deploy.ts --network base-goerli",
    "contracts:deploy:post2": "cross-env TS_NODE_PROJECT=./hardhat.tsconfig.json hardhat run app/basemorning/scripts/deployPostContract2.ts",
    "contracts:deploy:post2:base": "cross-env TS_NODE_PROJECT=./hardhat.tsconfig.json hardhat run app/basemorning/scripts/deployPostContract2.ts --network base",
    "contracts:deploy:post2:sepolia": "cross-env TS_NODE_PROJECT=./hardhat.tsconfig.json hardhat run app/basemorning/scripts/deployPostContract2.ts --network base-sepolia",
    "contracts:test": "cross-env TS_NODE_PROJECT=./hardhat.tsconfig.json hardhat test",
    "db:setup": "ts-node app/basemorning/scripts/setup-mongodb-indexes.ts",
    "db:indexes": "ts-node app/basemorning/scripts/setup-mongodb-indexes.ts"
  },
  "dependencies": {
